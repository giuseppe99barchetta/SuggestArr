{
  "name": "suggestarr",
  "version": "v2.13.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint --ext .js,.vue src/",
    "lint:styles": "stylelint \"src/**/*.{vue,css}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"src/**/*.{vue,css}\" --fix --allow-empty-input",
    "start": "vite"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "axios": "^1.8.2",
    "core-js": "^3.8.3",
    "cron-parser": "^5.5.0",
    "swagger-ui-dist": "5.32.14",
    "vue": "^3.2.13",
    "vue-multiselect": "^3.1.0",
    "vue-router": "^5.0.3",
    "vue-toast-notification": "^3.1.3",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.9.0",
    "typescript": "~7.0.2",
    "vite": "^7.3.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
